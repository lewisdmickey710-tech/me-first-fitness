# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the client magic-link email as the redirect target. Set to your
# deployed URL in production (e.g. https://mefirstfitness.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key for server-only code with no signed-in user (the
# reminders cron job). Project Settings -> API -> service_role key.
# NEVER prefix this with NEXT_PUBLIC_ -- it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A random secret only Vercel Cron and you know, used to authorize calls to
# /api/cron/reminders so no one else can trigger it. Any long random string
# works, e.g. generate one with `openssl rand -hex 32`.
CRON_SECRET=change-me-to-a-random-string

# Resend (resend.com) sends the reminder emails. Free tier is generous
# (100/day, 3000/month). Get an API key from the Resend dashboard.
RESEND_API_KEY=your-resend-api-key

# Must be an address at a domain you've verified in Resend (Domains ->
# Add Domain, then add the DNS records they give you). Until you verify a
# domain, Resend's sandbox will only actually deliver to your own account
# email -- reminders to real clients won't go out.
EMAIL_FROM="MeFirstFitness <reminders@yourdomain.com>"
