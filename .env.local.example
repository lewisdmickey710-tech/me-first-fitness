# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API).

# Re-skin the app for a different business without touching code. All
# optional -- unset, they default to this app's current MeFirstFitness
# branding (see src/lib/brand.ts). Standing up a new business on this
# codebase? Set these, then also see FORKING.md for everything else
# (icon/manifest, legal doc content, and personalizing the client-facing
# copy in src/lib/i18n.ts that mentions the coach by name).
NEXT_PUBLIC_BRAND_NAME=MeFirstFitness
NEXT_PUBLIC_BRAND_TAGLINE="Mind & Muscle Mechanics"
NEXT_PUBLIC_BRAND_COACH_NAME=Mickey
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#E75480

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the client magic-link email as the redirect target. Set to your
# deployed URL in production (e.g. https://mefirstfitness.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key for server-only code with no signed-in user (the
# reminders cron job). Project Settings -> API -> service_role key.
# NEVER prefix this with NEXT_PUBLIC_ -- it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A random secret only Vercel Cron and you know, used to authorize calls to
# /api/cron/reminders so no one else can trigger it. Any long random string
# works, e.g. generate one with `openssl rand -hex 32`.
CRON_SECRET=change-me-to-a-random-string

# Resend (resend.com) sends the reminder emails. Free tier is generous
# (100/day, 3000/month). Get an API key from the Resend dashboard.
RESEND_API_KEY=your-resend-api-key

# Must be an address at a domain you've verified in Resend (Domains ->
# Add Domain, then add the DNS records they give you). Until you verify a
# domain, Resend's sandbox will only actually deliver to your own account
# email -- reminders to real clients won't go out.
EMAIL_FROM="MeFirstFitness <reminders@yourdomain.com>"

# Web push (browser notifications). This keypair identifies your server to
# push services (Apple/Google/etc) -- generate your own once with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose (it's sent to every browser); the
# private key signs outgoing notifications and must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
