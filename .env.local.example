# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the client magic-link email as the redirect target. Set to your
# deployed URL in production (e.g. https://mefirstfitness.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
